{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "kraenkvisuell/statamic-bunny-cache",
    "description": "Full static caching for Statamic on the bunny.net CDN: pages are cached at the edge and purged through the bunny.net API whenever Statamic invalidates them. No nginx rewrite rules, no public/static folder.",
    "keywords": [
        "statamic",
        "statamic-addon",
        "static-caching",
        "bunny",
        "bunny.net",
        "cdn"
    ],
    "homepage": "https://github.com/kraenkvisuell/statamic-bunny-cache",
    "license": "MIT",
    "type": "statamic-addon",
    "authors": [
        {
            "name": "Sebastian Hilger",
            "email": "hilger@kraenk.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^10.0||^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Kraenkvisuell\\StatamicBunnyCache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kraenkvisuell\\StatamicBunnyCache\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint --parallel",
        "lint:check": "vendor/bin/pint --parallel --test",
        "analyse": "vendor/bin/phpstan analyse",
        "test:unit": "vendor/bin/pest",
        "test": [
            "@analyse",
            "@lint:check",
            "@test:unit"
        ]
    },
    "extra": {
        "statamic": {
            "name": "Bunny Cache",
            "description": "Full static caching on the bunny.net CDN with automatic purging"
        },
        "laravel": {
            "providers": [
                "Kraenkvisuell\\StatamicBunnyCache\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true,
            "pixelfear/composer-dist-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
